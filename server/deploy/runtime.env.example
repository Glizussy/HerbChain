# Copy to runtime.env privately; never commit that populated file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_LOCALLY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY
FABRIC_IDENTITIES_FILE=/run/herbchain/identities.json
PUBLIC_IDENTITY=consumer-reader
FABRIC_CHANNEL=herbchain
FABRIC_CHAINCODE=herbchain
FABRIC_MAX_CONNECTIONS=128
HERBCHAIN_MEMBERSHIP_MODE=supabase
HERBCHAIN_BATCH_LIST_MODE=indexed
HERBCHAIN_EVIDENCE_MODE=archive
HERBCHAIN_EVIDENCE_READ_MODE=cloud
HERBCHAIN_WRITE_MODE=queued
HERBCHAIN_LOTS_ENABLED=false
HERBCHAIN_DATA_DIR=/app/runtime
