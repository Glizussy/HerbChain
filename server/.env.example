HOST=127.0.0.1
PORT=3001
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
FABRIC_IDENTITIES_FILE=./identities.local.json
FABRIC_CHANNEL=herbchain
FABRIC_CHAINCODE=herbchain
PUBLIC_IDENTITY=consumer-reader

# Optional real HTTPS app links for the farmer dashboard prompt.
HERBCHAIN_APP_DOWNLOAD_URL=
HERBCHAIN_APP_OPEN_URL=
# Private durable evidence directory; keep outside any public/static directory.
HERBCHAIN_DATA_DIR=/home/YOUR_LINUX_USER/herbchain-fabric/harvest-data
# Phase 1B: keep file until migrations, seeds and batch assignments are ready.
HERBCHAIN_MEMBERSHIP_MODE=file
# Required only for supabase mode. SERVER ONLY: never use an EXPO_PUBLIC_ variable.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Phase 2: use indexed only after migration 002 and indexer backfill.
HERBCHAIN_BATCH_LIST_MODE=local

# Phase 3A: local (default), or archive (verified cloud copy before new transactions).
HERBCHAIN_EVIDENCE_MODE=local

# Enable only after archive backfill and verification; requires archive write mode.
HERBCHAIN_EVIDENCE_READ_MODE=local

# Enable only after migration 004+005, archive backfill and worker validation.
HERBCHAIN_WRITE_MODE=local
FABRIC_MAX_CONNECTIONS=128

# Automatic account enrollment. The pilot launcher enables farmers by default.
# Direct production deployments must explicitly opt in and choose administrators.
HERBCHAIN_ONBOARDING_ENABLED=false
HERBCHAIN_AUTO_APPROVE_FARMERS=false
HERBCHAIN_ONBOARDING_ADMIN_IDS=
HERBCHAIN_ONBOARDING_HOURLY_LIMIT=100
FABRIC_SAMPLES=/home/YOUR_LINUX_USER/herbchain-fabric/fabric-samples
